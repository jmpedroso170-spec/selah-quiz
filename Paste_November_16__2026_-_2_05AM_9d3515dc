/* professor: sala */
const rref=()=>doc(db,'rooms',V.pin);
function prepSetup(){
 $('lesson').innerHTML=D.lessons.map(l=>`<option value="${l.id}">${esc(l.title)} (${l.qs.length})</option>`).join('');
 const sync=()=>{const l=D.lessons.find(x=>x.id===$('lesson').value);if(!l)return;setT('pvTitle',l.title);
  const n=l.qs.length,o=[...new Set([5,10,n].filter(x=>x<=n&&x>0))].sort((a,b)=>a-b);
  $('questionCount').innerHTML=o.map(x=>`<option value="${x}" ${x===o[o.length-1]?'selected':''}>${x===n?'Todas ('+n+')':x+' perguntas'}</option>`).join('');setT('previewQCount',o[o.length-1]||0)};
 $('lesson').onchange=sync;sync()}
async function createRoom(){
 const l=D.lessons.find(x=>x.id===$('lesson').value);if(!l||!l.qs.length){toast('Escolha uma lição com perguntas.');return}
 const qs=l.qs.slice(0,+$('questionCount').value||l.qs.length),tl=+$('timeLimit').value,pin=String(100000+Math.floor(Math.random()*900000));
 V.pin=pin;V.lesson={...l,qs};V.tl=tl;V.pl=[];V.qi=0;V.room={state:'lobby'};
 try{await setDoc(doc(db,'rooms',pin),{title:l.title,tl,qs:qs.map(q=>({q:q.q,o:q.o})),state:'lobby',qi:0,reveals:{},board:[]});
  await setDoc(doc(db,'rooms',pin,'secret','key'),{ans:qs.map(q=>q.a)})}catch(e){toast('Erro ao criar a sala. Confira as regras do Firestore.');V.pin=null;return}
 V.u2=onSnapshot(collection(db,'rooms',pin,'players'),s=>{V.pl=s.docs.map(d=>({id:d.id,...d.data()}));renderParticipants();updateHost()});
 setT('roomPin',pin.slice(0,3)+' '+pin.slice(3));setT('siteUrl',location.host+location.pathname);go('lobby')}
function renderParticipants(){setT('playerCount',V.pl.length);const e=$('participants');if(e)e.innerHTML=V.pl.map(p=>avatarCard((p.avatar&&p.avatar.baseIndex)||0,p.name,(p.avatar&&p.avatar.type)||'',p.avatar)).join('')}
function copyPin(){navigator.clipboard&&navigator.clipboard.writeText(V.pin);toast('PIN copiado!')}
function startGame(){if(!V.pl.length){toast('Aguarde ao menos um aluno entrar.');return}startQ(0)}
async function startQ(i){V.qi=i;V.room={state:'q'};await updateDoc(rref(),{state:'q',qi:i});
 const q=V.lesson.qs[i];setT('hostTitle',V.lesson.title);setT('qIndex',i+1);setT('qTotal',V.lesson.qs.length);setT('sideQuestion',(i+1)+'/'+V.lesson.qs.length);setT('hostQuestion',q.q);
 $('hostAnswers').innerHTML=q.o.map((a,k)=>`<button class="answer ${CL[k]}" disabled><span class="shape">${SH[k]}</span><span>${esc(a)}</span></button>`).join('');
 $('revealBtn').disabled=false;$('hostResultSide').innerHTML='<p class="small muted" style="margin-top:15px">A distribuição das respostas aparece aqui após revelar.</p>';
 updateHost();go('hostgame');clearInterval(V.ti);V.rem=V.tl;tickH();V.ti=setInterval(()=>{V.rem--;tickH();if(V.rem<=0)revealAnswer()},1000)}
function tickH(){setT('hostTimer','⏱ '+Math.max(0,V.rem)+'s');$('progress').style.width=Math.max(0,V.rem/V.tl*100)+'%'}
function updateHost(){if(!V.room||V.room.state!=='q')return;const n=V.pl.length,k=V.pl.filter(p=>p.ans&&p.ans[V.qi]).length;
 setT('answeredCount',k);setT('totalCount',n);setT('sideAnswered',k);setT('sidePlayers',n);if(n&&k===n&&on('hostgame'))revealAnswer()}
function scores(){return V.pl.map(p=>{let s=0;const ans=V.lesson.qs.map((q,i)=>{const r=p.ans&&p.ans[i],c=r?r.c:null,pp=r?pts(c,q.a,r.t,V.tl):0;s+=pp;return{c,ok:c===q.a,pts:pp}});return{name:p.name,av:p.avatar,score:s,ans}}).sort((a,b)=>b.score-a.score)}
async function revealAnswer(){
 if(!V.room||V.room.state!=='q')return;V.room.state='result';clearInterval(V.ti);
 const q=V.lesson.qs[V.qi],sc=scores(),cnt=[0,1,2,3].map(k=>V.pl.filter(p=>p.ans&&p.ans[V.qi]&&p.ans[V.qi].c===k).length),tot=cnt.reduce((a,b)=>a+b,0);
 setT('revealQuestion',q.q);setT('correctAnswer','Resposta correta: '+q.o[q.a]);setT('explanation',(q.why||'')+(q.ref?' ('+q.ref+')':''));
 setT('revealTitle',cnt[q.a]+' de '+V.pl.length+' respostas corretas');setT('nextBtn',V.qi+1<V.lesson.qs.length?'Próxima pergunta →':'Ver pódio final →');
 $('distribution').innerHTML=cnt.map((n,i)=>`<div style="margin:12px 0"><div style="display:flex;justify-content:space-between;font-size:13px;font-weight:800"><span>${SH[i]} ${esc(q.o[i])}</span><span>${n}</span></div><div class="bar"><i style="width:${V.pl.length?n/V.pl.length*100:0}%;background:${['#e64b5d','#2774de','#dca51d','#269b62'][i]}"></i></div></div>`).join('');
 go('reveal');
 try{await updateDoc(rref(),{state:'result',['reveals.'+V.qi]:{a:q.a,why:q.why||'',ref:q.ref||''},board:sc.slice(0,5).map(p=>({name:p.name,av:p.av,score:p.score}))})}catch(e){toast('Falha ao enviar o resultado.')}}
function advanceAfterReveal(){if(V.qi+1>=V.lesson.qs.length){finishGame();return}
 $('leaderRows').innerHTML=scores().map((p,i)=>`<div class="leader-row"><div class="rank-num">${i+1}</div><span class="avatar-wrap">${av(p.av)}</span><div class="who">${esc(p.name)}</div><div class="score">${p.score} pts</div></div>`).join('');go('leaderboard')}
function continueFromBoard(){startQ(V.qi+1)}
async function finishGame(){
 const sc=scores();V.room={state:'end'};
 const pl=[sc[1],sc[0],sc[2]],cls=['second','first','third'];
 $('finalPodium').innerHTML=pl.map((p,i)=>p?`<div class="podium-place ${cls[i]}"><span class="avatar-wrap">${av(p.av)}</span><strong>${i===1?'1º':i===0?'2º':'3º'}</strong><b>${esc(p.name)}</b><small>${p.score} pontos</small></div>`:'').join('');
 go('podium');
 try{await updateDoc(rref(),{state:'end',board:sc.map(p=>({name:p.name,av:p.av,score:p.score}))});
  await addDoc(collection(db,'sessions'),{lid:V.lesson.id,date:new Date().toISOString(),demo:false,qs:V.lesson.qs.map(q=>({q:q.q,o:q.o,t:q.o[q.a],a:q.a})),players:sc})}catch(e){toast('Falha ao salvar o relatório.')}}
function showSummary(){V.rl=Math.max(0,D.lessons.findIndex(l=>l.id===V.lesson.id));V.rs=-1;go('reports')}
function leave(){if(V.pin&&V.room&&!['lobby','end'].includes(V.room.state)&&!confirm('Encerrar a partida em andamento?'))return false;
 if(V.pin){clearInterval(V.ti);V.u2&&V.u2();const p=V.pin;V.pin=null;V.room=null;deleteDoc(doc(db,'rooms',p,'secret','key')).then(()=>deleteDoc(doc(db,'rooms',p))).catch(()=>{})}return true}
