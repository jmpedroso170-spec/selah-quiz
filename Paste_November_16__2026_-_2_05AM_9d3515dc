 try{await updateDoc(doc(db,'rooms',V.spin,'players',V.uid),{['ans.'+r.qi]:{c:k,t}})}catch(e){toast('Não consegui enviar sua resposta.')}}
function renderStudent(){
 const r=V.sroom;if(!r||!on('student'))return;const rv=r.reveals||{},i=r.qi,q=r.qs[i],A=$('studentAnswers'),Q=$('studentQuestion'),F=$('studentFeedback');setT('studentTitle',r.title);
 if(r.state==='lobby'){setT('studentTimer','');Q.textContent='Você está dentro! Aguarde o professor iniciar.';A.innerHTML=`<div style="grid-column:1/-1;text-align:center">${avatarSVG(myAvatar.baseIndex||0,'lg',myAvatar)}<h2 style="color:#fff">${esc(V.sname)}</h2></div>`;F.innerHTML='';return}
 if(r.state==='end'){const b=r.board||[],pos=b.findIndex(p=>p.name===V.sname);setT('studentTimer','');Q.textContent=pos>=0?'Fim! Você ficou em '+(pos+1)+'º lugar 🏆':'Fim do quiz!';
  A.innerHTML=`<div style="grid-column:1/-1">${b.slice(0,5).map((p,k)=>`<div class="leader-row"><div class="rank-num">${k+1}</div><span class="avatar-wrap">${av(p.av)}</span><div class="who">${esc(p.name)}</div><div class="score">${p.score} pts</div></div>`).join('')}</div>`;F.innerHTML='';return}
 Q.textContent=q.q;const rev=rv[i];
 A.innerHTML=q.o.map((a,k)=>`<button class="answer student-answer ${CL[k]}${rev?(k===rev.a?' correct':V.sel===k?' wrong':''):''}" ${V.sel!=null||r.state!=='q'?'disabled':''} onclick="studentPick(${k})"><span class="shape">${SH[k]}</span><span>${esc(a)}</span></button>`).join('');
