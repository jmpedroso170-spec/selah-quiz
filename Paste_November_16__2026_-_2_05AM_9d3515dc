async function joinRoom(){
 const pin=$('joinPin').value.replace(/\D/g,''),nm=$('nick').value.trim();
 if(pin.length<6||!nm){toast('Digite o PIN de 6 números e seu apelido.');return}
 try{if(!auth.currentUser||auth.currentUser.email)await signInAnonymously(auth);
  const snap=await getDoc(doc(db,'rooms',pin));if(!snap.exists()){toast('PIN não encontrado. Confira com o professor.');return}
  V.spin=pin;V.uid=auth.currentUser.uid;V.sname=nm;V.sroom=snap.data();V.my={};V.sel=null;if(V.sroom.state==='q')V.t0=Date.now();
  await setDoc(doc(db,'rooms',pin,'players',V.uid),{name:nm,avatar:myAvatar,ans:{}});
  saveAvatarLocal();try{localStorage.setItem('selah.nick',nm)}catch(e){}
  onSnapshot(doc(db,'rooms',pin),s=>{const r=s.data();if(!r)return;
   if(r.state==='q'&&(V.sroom.state!=='q'||V.sroom.qi!==r.qi)){V.t0=Date.now();V.sel=null}
   V.sroom=r;renderStudent()});
  setT('stuName',nm);go('student');renderStudent();clearInterval(V.tk);
  V.tk=setInterval(()=>{const r=V.sroom;if(!r||r.state!=='q')return;const rem=Math.max(0,r.tl-Math.floor((Date.now()-V.t0)/1000));setT('studentTimer','⏱ '+rem+'s');$('studentProgress').style.width=rem/r.tl*100+'%'},500)
 }catch(e){toast('Não foi possível entrar. Confira o PIN e a internet.')}}
